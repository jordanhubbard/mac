{
  "id": "mac-continuity",
  "name": "MAC identity and memory continuity",
  "kind": "memory",
  "description": "Injects MAC mood and scoped memory, provides evidence-gated curiosity tools, and lets the agent adjust its allowlisted config flags conversationally.",
  "activation": {"onStartup": true},
  "contracts": {"tools": ["memory_search", "memory_get", "memory_store", "mac_memory_recall", "mac_memory_store", "mac_mood_current", "mac_mood_set", "mac_mood_clear", "mac_config_flag_list", "mac_config_flag_set", "mac_config_flag_clear", "curiosity_candidate_submit", "curiosity_candidates_list", "curiosity_abuse_frame"]},
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "maxMemories": {"type": "integer", "minimum": 0, "maximum": 20},
      "timeoutMs": {"type": "integer", "minimum": 100, "maximum": 20000},
      "curiosityBin": {"type": "string", "minLength": 1}
    }
  }
}
