[Unit]
Description=mac nap-tick — drive due nap cycles for all agents
Documentation=https://github.com/jordanh/mac
After=mac.service mac-qdrant.service
Requires=mac.service

[Service]
Type=oneshot
User=__MAC_USER__
WorkingDirectory=__MAC_HOME__

# Defaults; override in /etc/mac/nap-tick.env. The TokenHub embed
# backend is opt-in (set MAC_MEMORY_EMBED_BACKEND=tokenhub there or
# the timer just won't embed and will use the hash stub).
EnvironmentFile=-__MAC_HOME__/mac.env
EnvironmentFile=-/etc/mac/nap-tick.env

# `mac nap due` emits a JSON list; jq pulls out agent_ids; xargs runs
# `mac nap cycle` for each. Errors per-agent don't stop the tick
# (--no-run-if-empty keeps a clean exit when nothing is due).
ExecStart=/bin/bash -lc '\
  set -euo pipefail; \
  __MAC_HOME__/venv/bin/mac nap due 2>/dev/null \
    | python3 -c "import sys,json; print(\\\"\\\\n\\\".join(t[\\\"agent_id\\\"] for t in json.load(sys.stdin)))" \
    | xargs --no-run-if-empty -I{} __MAC_HOME__/venv/bin/mac nap cycle {} \
        --qdrant-url=${MAC_QDRANT_URL:-http://127.0.0.1:6333} \
        --actor=nap-tick.service'

StandardOutput=journal
StandardError=journal
