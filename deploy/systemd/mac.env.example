# Copy to /etc/mac/mac.env (mode 0600, owner root:mac) and edit before
# enabling mac.service.
#
# Generate the secret key once:
#   openssl rand -base64 48

MAC_SECRET_KEY=REPLACE-ME-WITH-A-32-PLUS-CHAR-RANDOM-STRING

# Database location. Defaults to ./mac.db relative to WorkingDirectory.
MAC_DB=/var/lib/mac/mac.db

# Hermes state/startup contract. These checks are metadata-only; contents of
# souls, memories, auth files, and Slack accounts are not returned by mac.
HERMES_HOME=/home/mac/.hermes
ACC_DIR=/home/mac/.acc
# Slack home-channel discovery writes slack_home_channels.json from
# slack_accounts.json. Set without the leading "#".
MAC_HERMES_SLACK_HOME_CHANNEL_NAME=
MAC_HERMES_SYNC_SLACK_HOME_CHANNELS=1
SLACK_ALLOWED_USERS=*
SLACK_REQUIRE_MENTION=true
SLACK_STRICT_MENTION=true
# MAC_HERMES_AGENT_DIR=/opt/hermes-agent
# MAC_HERMES_APPLY_SLACK_ACCOUNT_SHIM=1
# MAC_HERMES_APPLY_GATEWAY_RUNTIME_SHIM=1
# MAC_HERMES_GATEWAY_MODEL=azure/openai/gpt-5.5
# MAC_HERMES_GATEWAY_PROVIDER=custom
# MAC_HERMES_GATEWAY_BASE_URL=http://127.0.0.1:8789/v1
# MAC_SELF_UPDATE_REPO=/opt/mac
# MAC_REQUIRE_HERMES_STARTUP_READY=1
# MAC_HERMES_STARTUP_CHECK=1
MAC_URL=http://hub.example.internal:8789
MAC_CLIENT_PRINCIPALS_FILE=/var/lib/mac/client-principals.json
MAC_FLEET_TENANT_ID=tenant_example
MAC_AGENT_ID=agent_example
MAC_HERMES_PERSONA_ID=persona_example
MAC_HERMES_INSTANCE_ID=hermes_example
MAC_WORKER_HERMES_INSTANCE_ID=hermes_example
MAC_HERMES_RUNTIME_CONTEXT_FILE=/home/mac/.hermes/mac-runtime-context.json
MAC_HERMES_RUNTIME_CONTEXT_MARKDOWN=/home/mac/.hermes/mac-runtime-context.md
MAC_HERMES_RUNTIME_CONTEXT_REQUIRED=1
MAC_HERMES_WORKSPACE=/home/mac/.mac/src/mac
MAC_PROJECT_CONTRACT_FILE=/home/mac/.mac/src/mac/.mac/project.yaml
MAC_WORKER_EXECUTOR=/home/mac/.mac/bin/mac-hermes-task-executor

# Hub-owned managed-branch retirement. `prune` audits every enabled registered
# repository and deletes only refs that pass the lifecycle, PR, ancestry,
# canonical-remote, grace-period, and exact-SHA checks. Use `audit` during a
# rollout, or `off` on spokes/stateless API replicas.
MAC_REPOSITORY_REF_RECONCILER_MODE=prune
MAC_REPOSITORY_REF_RECONCILER_INTERVAL_SECONDS=86400
MAC_REPOSITORY_REF_RECONCILER_INITIAL_DELAY_SECONDS=300
MAC_REPOSITORY_REF_RECONCILER_GRACE_DAYS=7

# OpenShell first-class runtime. Required Linux agents should run
# mac-openshell-supervisor as the parent for MAC/Hermes runtime work.
# MAC-managed assigned policy should be materialized at the path below before
# starting the supervisor. Legacy MAC_OPENSHELL_SANDBOX and
# MAC_OPENSHELL_GATEWAY remain compatibility knobs only.
MAC_OPENSHELL_REQUIRED=1
MAC_OPENSHELL_POLICY=/home/mac/.mac/openshell/${MAC_AGENT_ID}-policy.yaml
MAC_OPENSHELL_EVENTS_FILE=/home/mac/.mac/openshell/${MAC_AGENT_ID}-events.jsonl
MAC_ALLOW_UNSANDBOXED_YOLO=0

# In-mac model router (the gateway's upstream). With MAC_ROUTER_BACKEND=inproc
# the agent's mac API mounts a local OpenAI-compatible /v1 front door and its
# own gateway routes through that. The router holds the real upstream provider
# key (MAC_ROUTER_PROVIDERS key=secret:<name>, resolved from mac's encrypted
# vault) and presents it upstream; the gateway itself only presents this agent's
# own mac token (agent scope) to the local /v1. The deploy derives
# OPENAI_API_KEY / MAC_HERMES_GATEWAY_API_KEY from the agent's MAC_API_TOKEN
# automatically — the placeholders below are overwritten on deploy.
MAC_ROUTER_BACKEND=inproc
MAC_ROUTER_PROVIDERS=nvidia=https://inference-api.nvidia.com/v1,0,key=secret:nvidia-upstream
MAC_ROUTER_DEFAULT_MODEL=azure/anthropic/claude-sonnet-4-6
MAC_ROUTER_WILDCARD_MODELS=azure/anthropic/claude-sonnet-4-6|azure/anthropic/claude-opus-4-6
OPENAI_API_KEY=mac_REPLACE_ME
MAC_HERMES_GATEWAY_API_KEY=mac_REPLACE_ME
OPENAI_BASE_URL=http://127.0.0.1:8789/v1
CUSTOM_BASE_URL=http://127.0.0.1:8789/v1
MAC_HERMES_GATEWAY_BASE_URL=http://127.0.0.1:8789/v1
MAC_HERMES_GATEWAY_PROVIDER=custom
MAC_HERMES_GATEWAY_MODEL=*
HERMES_INFERENCE_PROVIDER=custom
HERMES_INFERENCE_MODEL=*

# Image generation (optional). When NVIDIA_API_KEY is set, the deploy enables
# the NVIDIA NIM image_gen backend (FLUX.1 / SDXL) and the agent's core
# `image_generate` tool becomes usable. The key must have image-NIM access at
# build.nvidia.com. Chat routing is unaffected — it stays pinned to the in-mac
# router (only the NVIDIA base URLs are stripped, never this key). Provide it per-agent
# via the fleet config (NVIDIA_API_KEY or NVIDIA_API_KEY__<AGENT>).
# NVIDIA_API_KEY=nvapi-REPLACE_ME
# Optional model override (default flux.1-dev): flux.1-dev | flux.1-schnell | sdxl
# NVIDIA_IMAGE_MODEL=flux.1-dev

# Memory embeddings (mem-store-02). MAC_MEMORY_EMBED_BACKEND defaults to "auto":
# real semantic embeddings turn on automatically once a model + endpoint are
# resolvable (base_url/key fall back to OPENAI_BASE_URL/OPENAI_API_KEY, i.e. the
# in-mac router). Set the embed model to activate; leave unset for the offline
# hash stub. Use a model your router actually serves.
# MAC_MEMORY_EMBED_MODEL=nvcf/nvidia/llama-3.2-nv-embedqa-1b-v2
# MAC_MEMORY_EMBED_BACKEND=auto   # auto (default) | hash (offline)

# Supervisor/topology metadata. Fleet deploy sets this dynamically to systemd,
# launchd, or supervisord.
# MAC_SUPERVISOR_KIND=systemd

# Hub-managed shared memory service. The hub owns Qdrant; spokes point at the
# hub URL. Startup readiness validates /collections and reports redacted
# topology in /startup/hermes.
MAC_SHARED_SERVICES_MANAGER_AGENT=hub
MAC_MEMORY_TOPOLOGY_FILE=/home/mac/.hermes/mac-memory-topology.json
MAC_REQUIRE_QDRANT_MEMORY=1
MAC_QDRANT_MEMORY_ROLE=shared_level2
QDRANT_URL=http://hub.example.internal:6333
QDRANT_ADDRESS=http://hub.example.internal:6333
QDRANT_FLEET_URL=http://hub.example.internal:6333
# QDRANT_API_KEY=

# Hub-managed Firecrawl-compatible web search service. The hub exposes the
# endpoint and all agents use it for Hermes web search/extraction tools.
MAC_REQUIRE_FIRECRAWL=1
MAC_WEB_SEARCH_PROVIDER=firecrawl
MAC_WEB_SEARCH_URL=http://hub.example.internal:3002
FIRECRAWL_API_URL=http://hub.example.internal:3002
FIRECRAWL_GATEWAY_URL=http://hub.example.internal:3002
FIRECRAWL_API_KEY=none
HERMES_WEB_SEARCH_BACKEND=firecrawl
HERMES_WEB_EXTRACT_BACKEND=firecrawl

# Bearer auth — pick ONE.
# Single admin token:
# MAC_API_TOKEN=<random-token-here>
#
# Or scoped tokens (JSON):
# MAC_API_TOKENS={"reader":["read"],"worker":["agent","dispatch"],"ops":["admin"]}
