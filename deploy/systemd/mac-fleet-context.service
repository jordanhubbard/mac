[Unit]
Description=mac fleet-context — refresh this agent's live view of its teammates
Documentation=https://github.com/jordanh/mac
# Spokes intentionally have no local mac.service; refresh-context reads their
# remote hub authority from mac.env.  Network readiness is the only common
# ordering requirement across hub and spoke roles.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__MAC_USER__
WorkingDirectory=__MAC_HOME__
EnvironmentFile=-__MAC_HOME__/mac.env

# fleet-02 + mood-01: refresh the live "Fleet — your teammates" block AND the
# agent's mood overlay in its runtime-context markdown, so each new hermes
# session knows what teammates are doing and behaves in its current mood.
# --agent excludes the caller from its own fleet view.
#
# Runs against the selected hub authority. Hub nodes may use explicit local
# SQLite; spokes have no MAC_DB and call the remote hub through MAC_HUB_URL.
# The mood overlay is also fetched from that hub.
ExecStart=/bin/bash -lc '\
  exec __MAC_HOME__/venv/bin/mac fleet refresh-context \
    --agent "${MAC_AGENT_ID:-${MAC_WORKER_AGENT_ID:-}}"'

StandardOutput=journal
StandardError=journal
