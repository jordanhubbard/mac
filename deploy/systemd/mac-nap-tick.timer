[Unit]
Description=Periodic trigger for mac nap-tick
Documentation=https://github.com/jordanh/mac

[Timer]
# Tick every 15 minutes. Each nap_schedule has a `window_minutes`
# default of 15, so a 15-min tick guarantees at least one chance
# per window. Operators with tighter windows can shorten this.
OnBootSec=5min
OnUnitActiveSec=15min
Persistent=true
Unit=mac-nap-tick.service

[Install]
WantedBy=timers.target
