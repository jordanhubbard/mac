[Unit]
Description=MAC stock OpenClaw gateway inside OpenShell
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__MAC_USER__
WorkingDirectory=__MAC_HOME__
Environment=HOME=__MAC_HOME__
Environment=OPENSHELL_GATEWAY_ENDPOINT=http://127.0.0.1:17670
ExecStart=__MAC_HOME__/bin/openclaw-gateway
ExecStop=__MAC_HOME__/bin/openclaw-gateway-stop
ExecStopPost=__MAC_HOME__/bin/openclaw-gateway-stop
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
SuccessExitStatus=143 SIGTERM
TimeoutStopSec=600
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
