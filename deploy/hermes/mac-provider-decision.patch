+def _mac_provider_decision():
+    """ADR 0001 (hu-03): mac's owned, in-process per-agent provider/model
+    override.
+
+    This is the first-class replacement for the runtime string-surgery mac used
+    to apply to this file from the outside
+    (``hermes_startup._apply_gateway_runtime_shim``). Because the Hermes runtime
+    is now vendored inside mac, the gateway calls mac directly instead of having
+    its source rewritten. Returns the ``ProviderDecision`` when an override is
+    configured, else ``None``; a no-op (returns ``None``) when ``mac`` is not
+    importable, i.e. standalone upstream Hermes.
+    """
+    try:
+        from mac.agent_provider import resolve_agent_provider
+    except Exception:
+        return None
+    try:
+        decision = resolve_agent_provider()
+    except Exception:
+        return None
+    return decision if decision.override_active else None
+
