+def test_initializer_runs_once_with_arguments_on_reused_worker():
+    local = threading.local()
+    initialized = []
+
+    def initialize(value):
+        local.value = value
+        initialized.append(threading.get_ident())
+
+    with DaemonThreadPoolExecutor(max_workers=1, initializer=initialize, initargs=(42,)) as pool:
