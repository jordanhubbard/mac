+def test_shell_runner_preserves_temporary_directory_without_credentials(tmp_path: Path) -> None:
+    repo_root = Path(__file__).resolve().parent.parent
+    temp_dir = tmp_path / "explicit-temporary-directory"
+    temp_dir.mkdir()
+    probe = tmp_path / "test_environment_probe.py"
+    probe.write_text(
+        "import os, tempfile\n"
+        "def test_temporary_directory_and_credentials():\n"
+        f"    assert os.environ.get('TMPDIR') == {str(temp_dir)!r}\n"
+        f"    assert tempfile.gettempdir() == {str(temp_dir)!r}\n"
+        "    assert 'OPENAI_API_KEY' not in os.environ\n",
+        encoding="utf-8",
+    )
+    env = os.environ.copy()
+    env.update(TMPDIR=str(temp_dir), OPENAI_API_KEY="test-must-not-reach-child")
+    proc = subprocess.run(
+        ["bash", str(repo_root / "scripts/run_tests.sh"), "-j", "1", str(probe)],
+        cwd=repo_root,
+        env=env,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        text=True,
+        timeout=120,
+    )
+    assert proc.returncode == 0, proc.stdout
+    assert "1 tests passed" in proc.stdout
+
+
