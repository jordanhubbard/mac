index d19848b..f1812f1 100644
--- a/agent/prompt_builder.py
+++ b/agent/prompt_builder.py
@@ -1559,6 +1559,21 @@ def _load_cursorrules(cwd_path: Path, context_length: Optional[int] = None) -> st
                              read_path=str(cwd_path / ".cursorrules"))


+def _load_external_runtime_context(context_length: Optional[int] = None) -> str:
+    """Optional deployment-owned context, additive to project and persona files."""
+    configured = os.environ.get("MAC_HERMES_RUNTIME_CONTEXT_MARKDOWN", "").strip()
+    if not configured:
+        return ""
+    path = Path(configured).expanduser()
+    content = _read_context_file(path)
+    if not content:
+        logger.warning("Configured MAC runtime context is missing or empty: %s", path)
+        return ""
+    return _context_section(
+        content, "MAC runtime context", "MAC runtime context", path, context_length,
+    )
+
+
 def build_context_files_prompt(
     cwd: Optional[str] = None, skip_soul: bool = False, context_length: Optional[int] = None,
     allow_install_tree_fallback: bool = False, home_override: "Path | None" = None,
@@ -1586,6 +1601,7 @@ def build_context_files_prompt(
     else:
         sections = [_load_hermes_md(cwd_path, context_length) or _load_agents_md(cwd_path, context_length)
                     or _load_claude_md(cwd_path, context_length) or _load_cursorrules(cwd_path, context_length)]
+    sections.append(_load_external_runtime_context(context_length))
     if not skip_soul:
         sections.append(load_soul_md(context_length, home_override=home_override))
     sections = [s for s in sections if s]
diff --git a/tests/agent/test_prompt_builder.py b/tests/agent/test_prompt_builder.py
index 3be8ddb..4f28de4 100644
--- a/tests/agent/test_prompt_builder.py
