@@ -414,7 +414,29 @@ class TestBuildContextFilesPrompt:
     def test_loads_agents_md(self, tmp_path):
         (tmp_path / "AGENTS.md").write_text("Use Ruff for linting.")
         result = build_context_files_prompt(cwd=str(tmp_path))
         assert "Ruff for linting" in result
         assert "Project Context" in result

+    def test_mac_runtime_context_is_additive_to_project_and_soul(self, tmp_path, monkeypatch):
+        workspace = tmp_path / "workspace"
+        workspace.mkdir()
+        (workspace / "AGENTS.md").write_text("existing user project instructions")
+        home = tmp_path / "hermes-home"
+        home.mkdir()
+        (home / "SOUL.md").write_text("existing persona context")
+        runtime = home / "mac-runtime-context.md"
+        runtime.write_text("MAC Task and Project Runtime")
+        monkeypatch.setenv("MAC_HERMES_RUNTIME_CONTEXT_MARKDOWN", str(runtime))
+
+        result = build_context_files_prompt(cwd=str(workspace), home_override=home)
+
+        assert "existing user project instructions" in result
+        assert "MAC Task and Project Runtime" in result
+        assert "existing persona context" in result
+
+    def test_missing_configured_mac_runtime_context_is_not_claimed(self, tmp_path, monkeypatch):
+        monkeypatch.setenv("MAC_HERMES_RUNTIME_CONTEXT_MARKDOWN", str(tmp_path / "missing.md"))
+        result = build_context_files_prompt(cwd=str(tmp_path), skip_soul=True)
+        assert "MAC runtime context" not in result
+
     # --- AGENTS.md directory chain (port of grok-cli instructions.ts) ---
