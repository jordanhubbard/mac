+    # An orphaned FTS schema is a virtual table whose declaration survived but
+    # whose backing shadow tables (``<name>_data``/``_idx``/``_docsize``/
+    # ``_config``) were lost or corrupted. A real FTS integrity probe then
+    # raises something other than "no such table: <the vtable itself>". A
+    # metadata-only ``SELECT ... LIMIT 0`` is insufficient here: some SQLite
+    # builds optimize it without opening every shadow table. Such errors are
+    # recoverable: drop the orphaned vtable + shadow tables + triggers, recreate
+    # from the canonical DDL, and backfill.
+    @staticmethod
+    def _is_fts_orphan_error(table: str, message: str) -> bool:
+        """True when *message* indicates an orphaned/corrupt FTS shadow schema.
+
+        A missing top-level virtual table (``no such table: <table>``) is the
+        normal first-run case and is handled by the fresh-create path, not
+        recovery. But ``no such table: <table>_data`` (or ``_idx``/``_docsize``/
+        ``_config``), "malformed database schema", "database disk image is
+        malformed", and "vtable constructor failed" all mean the vtable is
+        declared yet unusable — the orphan case this recovery targets.
+        """
+        err = message.lower()
+        if "database or disk is full" in err:
+            return False
+        # "no such table: messages_fts" alone is the fresh-create case.
+        if err.strip().endswith("no such table: %s" % table.lower()):
+            return False
+        if ("no such table" in err) and (
+            ("%s_" % table.lower()) in err or ("%s.%s" % ("main", table.lower())) in err
+        ):
+            return True
+        fts_corruption = (
+            "fts5: corruption found" in err
+            and (table.lower() in err or "from table" not in err)
+        )
+        if fts_corruption:
+            return True
+        for sig in ("malformed database schema", "database disk image is malformed",
+                    "vtable constructor failed"):
+            if sig in err:
+                return True
+        return False
