#!/usr/bin/env bash
# Review-verdict stub executor invoked by the K8s Job pod.
#
# Constructs a mac.worker_evidence.v1 manifest with evidence_type=review_verdict
# and signs it via `mac-evidence sign` (defined in src/mac/evidence_cli.py).
# No inline HMAC — see tests/test_evidence_cli.py for the byte-for-byte
# invariant against mac.services.sign_verification_manifest.
set -euo pipefail

MAC_TASK_ID="${MAC_TASK_ID:-}"
MAC_LEASE_ID="${MAC_LEASE_ID:-}"
MAC_AGENT_ID="${MAC_AGENT_ID:-mac-task-runner}"
MAC_AGENT_ROLE="${MAC_AGENT_ROLE:-}"
MAC_TASK_TITLE="${MAC_TASK_TITLE:-}"
MAC_URL="${MAC_URL:-}"
ATTESTATION_KEY="${MAC_AGENT_ATTESTATION_KEY:-}"
REVIEW_TARGET="${MAC_REVIEW_TARGET_EVIDENCE_ID:-pending-resolution-by-codex-runner}"
EVIDENCE_PATH="${MAC_TASK_EVIDENCE_MANIFEST_PATH:-/tmp/mac-evidence.json}"
LLM_MODEL="${MAC_LLM_MODEL:-${MAC_AGENT_LLM_MODEL:-${CODEX_MODEL:-${OPENAI_MODEL:-${MODEL:-}}}}}"

executed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

echo "===== mac-task-executor-codex-review ====="
echo "executed_at:      ${executed_at}"
echo "MAC_TASK_ID:      ${MAC_TASK_ID:-<unset>}"
echo "MAC_LEASE_ID:     ${MAC_LEASE_ID:-<unset>}"
echo "MAC_AGENT_ID:     ${MAC_AGENT_ID:-<unset>}"
echo "MAC_AGENT_ROLE:   ${MAC_AGENT_ROLE:-<unset>}"
echo "MAC_URL:          ${MAC_URL:-<unset>}"
echo "REVIEW_TARGET:    ${REVIEW_TARGET}"
echo "LLM_MODEL:        ${LLM_MODEL:-<unset>}"
echo "EVIDENCE_PATH:    ${EVIDENCE_PATH}"
if [ -n "${ATTESTATION_KEY}" ]; then
    echo "MAC_AGENT_ATTESTATION_KEY: <present, $(printf '%s' "${ATTESTATION_KEY}" | wc -c | tr -d ' ') chars>"
else
    echo "MAC_AGENT_ATTESTATION_KEY: <unset> (verdict manifest will be unsigned)"
fi
if command -v mac-evidence >/dev/null 2>&1; then
    MAC_EVIDENCE_CMD=("mac-evidence")
else
    MAC_EVIDENCE_PY="${MAC_EVIDENCE_PYTHON:-}"
    if [ -z "${MAC_EVIDENCE_PY}" ]; then
        MAC_EVIDENCE_PY="$(command -v python3 || command -v python || true)"
    fi
    if [ -z "${MAC_EVIDENCE_PY}" ]; then
        echo "[FATAL] mac-evidence is not on PATH and no python interpreter is available" >&2
        exit 3
    fi
    MAC_EVIDENCE_CMD=("${MAC_EVIDENCE_PY}" "-m" "mac.evidence_cli")
fi
echo "mac-evidence: ${MAC_EVIDENCE_CMD[*]}"
echo

# Export the values the inline python heredoc reads from os.environ.
export MAC_TASK_ID MAC_LEASE_ID MAC_AGENT_ID MAC_AGENT_ROLE MAC_TASK_TITLE
export executed_at REVIEW_TARGET LLM_MODEL

tmp_path="${EVIDENCE_PATH}.tmp.$$"
python3 - "${tmp_path}" <<'PYEOF'
import hashlib, json, os, sys

task_id = os.environ.get("MAC_TASK_ID", "").strip()
agent_id = os.environ.get("MAC_AGENT_ID", "").strip() or "mac-task-runner"
executed_at = os.environ.get("executed_at", "").strip()
review_target = (
    os.environ.get("REVIEW_TARGET", "").strip() or "pending-resolution-by-codex-runner"
)

digest_input = ("%s|%s|%s" % (task_id, review_target, executed_at)).encode("utf-8")
worktree_digest = "sha256:" + hashlib.sha256(digest_input).hexdigest()

manifest = {
    "schema": "mac.worker_evidence.v1",
    "status": "complete",
    "evidence_type": "review_verdict",
    "verdict": "approved",
    "reviewed_evidence_id": review_target,
    "worktree_digest": worktree_digest,
    "summary": (
        "mac-task-executor-codex-review (PR3 stub-pass) approved "
        "task=%s review_target=%s at %s" % (task_id, review_target, executed_at)
    ),
    "result": "review_completed_no_findings",
    "llm_model": os.environ.get("LLM_MODEL", ""),
    "llm": {
        "tool": "codex",
        "agent": "review",
        "model": os.environ.get("LLM_MODEL", ""),
    },
    "checks": [{"name": "review_completed", "status": "pass", "returncode": 0}],
    "executed_at": executed_at,
    "notes": "PR3: review_verdict manifest. Signing handled by mac-evidence sign.",
}

with open(sys.argv[1], "w", encoding="utf-8") as fh:
    json.dump(manifest, fh, sort_keys=True)
PYEOF

if [ -n "${ATTESTATION_KEY}" ]; then
    "${MAC_EVIDENCE_CMD[@]}" sign \
        --manifest "${tmp_path}" \
        --key-env MAC_AGENT_ATTESTATION_KEY \
        --signed-by "${MAC_AGENT_ID}"
    mv "${tmp_path}" "${EVIDENCE_PATH}"
    signed_state="yes"
else
    python3 - "${tmp_path}" "${EVIDENCE_PATH}" <<'PYEOF'
import json, os, sys
with open(sys.argv[1], "r", encoding="utf-8") as fh:
    manifest = json.load(fh)
manifest["status"] = "incomplete"
manifest["problems"] = [
    "MAC_AGENT_ATTESTATION_KEY is unset; verdict is structurally valid "
    "but unsigned."
]
with open(sys.argv[2], "w", encoding="utf-8") as fh:
    json.dump(manifest, fh, sort_keys=True)
os.unlink(sys.argv[1])
PYEOF
    signed_state="no"
fi

echo "[codex-review] wrote verification manifest to ${EVIDENCE_PATH} (signed=${signed_state})"
echo "[codex-review] done."
exit 0
