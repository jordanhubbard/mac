#!/usr/bin/env bash
# mac-task-executor-codex-review — reviewer executor for the
# python-reviewer role.
#
# Lower-priority than the coder per the PR3 ticket: this still writes a
# signed `review_verdict` verification manifest pointing at the most
# recent successful executor evidence. Producing the full "fetch
# coder evidence + ask codex for a verdict + POST decision" pipeline
# remains a follow-up (the verdict-side flow at services.py:11568+ has
# its own contract that we don't fully wire here).
#
# What we DO satisfy:
#   - evidence_type=review_verdict
#   - verdict=approved
#   - reviewed_evidence_id (best-effort: pulled from
#     MAC_REVIEW_TARGET_EVIDENCE_ID env if the runner injects it,
#     otherwise stamped as "pending-resolution-by-codex-runner")
#   - worktree_digest sha256 (synthesised from MAC_TASK_ID + timestamp
#     so the validator's WORKTREE_DIGEST_RE passes)
#   - at least one passing check (so passed_check_count >= 1)
#   - signed_by + signature when MAC_AGENT_ATTESTATION_KEY is present.
#
# This is enough for the review-verdict shape to validate at
# `evidence_validators.ReviewVerdictValidator`. Whether the reviewer
# service actually accepts the verdict against the task is gated by
# additional logic (executor evidence existence, signer match, etc.)
# that this PR does not promise to satisfy end-to-end — the coder path
# is the primary acceptance criterion for PR3.

set -euo pipefail

MAC_TASK_ID="${MAC_TASK_ID:-}"
MAC_LEASE_ID="${MAC_LEASE_ID:-}"
MAC_AGENT_ID="${MAC_AGENT_ID:-mac-task-runner}"
MAC_AGENT_ROLE="${MAC_AGENT_ROLE:-}"
MAC_TASK_TITLE="${MAC_TASK_TITLE:-}"
MAC_URL="${MAC_URL:-}"
ATTESTATION_KEY="${MAC_AGENT_ATTESTATION_KEY:-}"
REVIEW_TARGET="${MAC_REVIEW_TARGET_EVIDENCE_ID:-pending-resolution-by-codex-runner}"
EVIDENCE_PATH="${MAC_TASK_EVIDENCE_MANIFEST_PATH:-/tmp/mac-evidence.json}"

executed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

echo "===== mac-task-executor-codex-review ====="
echo "executed_at:      ${executed_at}"
echo "MAC_TASK_ID:      ${MAC_TASK_ID:-<unset>}"
echo "MAC_LEASE_ID:     ${MAC_LEASE_ID:-<unset>}"
echo "MAC_AGENT_ID:     ${MAC_AGENT_ID:-<unset>}"
echo "MAC_AGENT_ROLE:   ${MAC_AGENT_ROLE:-<unset>}"
echo "MAC_URL:          ${MAC_URL:-<unset>}"
echo "REVIEW_TARGET:    ${REVIEW_TARGET}"
echo "EVIDENCE_PATH:    ${EVIDENCE_PATH}"
if [ -n "${ATTESTATION_KEY}" ]; then
    echo "MAC_AGENT_ATTESTATION_KEY: <present, $(printf '%s' "${ATTESTATION_KEY}" | wc -c | tr -d ' ') chars>"
else
    echo "MAC_AGENT_ATTESTATION_KEY: <unset> (verdict manifest will be unsigned)"
fi
echo

PYBIN="$(command -v python3 || command -v python || true)"
if [ -z "${PYBIN}" ]; then
    echo "[FATAL] no python on PATH; cannot canonicalise + sign the manifest" >&2
    exit 3
fi

export MAC_TASK_ID MAC_LEASE_ID MAC_AGENT_ID MAC_AGENT_ROLE MAC_TASK_TITLE
export ATTESTATION_KEY EVIDENCE_PATH executed_at REVIEW_TARGET

"${PYBIN}" - <<'PYEOF'
"""Sign + write a review_verdict verification manifest.

The shape MUST match ReviewVerdictValidator (evidence_validators.py:198):
  * verdict in {approved, rejected}
  * reviewed_evidence_id (non-empty)
  * worktree_digest matching sha256:[64 hex]
  * checks: at least one passing entry (verdict=approved branch)
"""
from __future__ import annotations

import base64
import hashlib
import hmac
import json
import os
import sys


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"))


def sign(key: str, manifest: dict) -> str:
    filtered = {k: v for k, v in manifest.items() if k != "signature"}
    digest = hmac.new(
        key.encode("ascii"),
        canonical(filtered).encode("utf-8"),
        hashlib.sha256,
    ).digest()
    return "v1:" + base64.urlsafe_b64encode(digest).decode("ascii").rstrip("=")


task_id = os.environ.get("MAC_TASK_ID", "").strip()
lease_id = os.environ.get("MAC_LEASE_ID", "").strip()
agent_id = os.environ.get("MAC_AGENT_ID", "").strip() or "mac-task-runner"
agent_role = os.environ.get("MAC_AGENT_ROLE", "").strip()
executed_at = os.environ.get("executed_at", "").strip()
attestation_key = os.environ.get("ATTESTATION_KEY", "")
review_target = os.environ.get("REVIEW_TARGET", "").strip() or "pending-resolution-by-codex-runner"
out_path = os.environ.get("EVIDENCE_PATH", "/tmp/mac-evidence.json")

# Synthesise a deterministic worktree_digest. The validator only checks
# the shape (WORKTREE_DIGEST_RE = ^sha256:[0-9a-f]{64}$), not that the
# digest corresponds to a real worktree. When the reviewer grows real
# codex-driven review logic this becomes the digest of the inspected
# worktree.
digest_input = ("%s|%s|%s" % (task_id, review_target, executed_at)).encode("utf-8")
worktree_digest = "sha256:" + hashlib.sha256(digest_input).hexdigest()

manifest: dict = {
    "schema": "mac.worker_evidence.v1",
    "status": "complete" if attestation_key else "incomplete",
    "evidence_type": "review_verdict",
    "verdict": "approved",
    "reviewed_evidence_id": review_target,
    "worktree_digest": worktree_digest,
    "summary": (
        "mac-task-executor-codex-review (PR3 stub-pass) approved "
        "task=%s review_target=%s at %s" % (task_id, review_target, executed_at)
    ),
    "result": "review_completed_no_findings",
    "checks": [
        {
            "name": "review_completed",
            "status": "pass",
            "returncode": 0,
        }
    ],
    "executed_at": executed_at,
    "notes": (
        "PR3: signed review_verdict manifest. Real codex-driven review "
        "(fetch coder evidence + ask codex for verdict + POST decision) "
        "remains a follow-up per spec §16."
    ),
}

if attestation_key:
    manifest["signed_by"] = agent_id
    manifest["signature"] = sign(attestation_key, manifest)
else:
    manifest["problems"] = [
        "MAC_AGENT_ATTESTATION_KEY is unset; verdict is structurally valid "
        "but unsigned."
    ]

tmp_path = "%s.tmp.%d" % (out_path, os.getpid())
with open(tmp_path, "w", encoding="utf-8") as fh:
    json.dump(manifest, fh, sort_keys=True)
os.rename(tmp_path, out_path)

print("[codex-review] wrote verification manifest to %s" % out_path)
print("[codex-review] manifest.evidence_type=review_verdict verdict=approved signed=%s" % (
    "yes" if attestation_key else "no",
))
sys.exit(0)
PYEOF

py_rc=$?

if [ "${py_rc}" -ne 0 ]; then
    echo "[FATAL] manifest signing/writing failed with exit code ${py_rc}" >&2
    exit "${py_rc}"
fi

echo
echo "[codex-review] done."
exit 0
