#!/usr/bin/env bash
# Review-verdict executor that delegates semantic review to opencode's
# `review` agent, then passes the result through MAC's canonical deterministic
# finalizer for exact-checkout tests, CodeGraph, integration checks, and signing.
set -euo pipefail

MAC_TASK_ID="${MAC_TASK_ID:-}"
MAC_LEASE_ID="${MAC_LEASE_ID:-}"
MAC_AGENT_ID="${MAC_AGENT_ID:-mac-task-runner}"
MAC_AGENT_ROLE="${MAC_AGENT_ROLE:-}"
MAC_URL="${MAC_URL:-}"
MAC_WORKER_TOKEN="${MAC_WORKER_TOKEN:-}"
ATTESTATION_KEY="${MAC_AGENT_ATTESTATION_KEY:-${MAC_ATTESTATION_KEY:-}}"
REVIEW_TARGET="${MAC_REVIEW_TARGET_EVIDENCE_ID:-pending-resolution-by-opencode-runner}"
EVIDENCE_PATH="${MAC_TASK_EVIDENCE_MANIFEST_PATH:-/tmp/mac-evidence.json}"

export HOME=/tmp/opencode-home
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_CACHE_HOME="${HOME}/.cache"
export XDG_STATE_HOME="${HOME}/.local/state"
mkdir -p "${HOME}/.local" "${XDG_CONFIG_HOME}/opencode" "${XDG_DATA_HOME}" "${XDG_CACHE_HOME}" "${XDG_STATE_HOME}"
# Source config is the ConfigMap mount at /etc/opencode, overridable for
# tests via MAC_OPENCODE_CONFIG_PATH.
OPENCODE_CONFIG_SRC="${MAC_OPENCODE_CONFIG_PATH:-/etc/opencode/opencode.json}"
OPENCODE_CONFIG_DST="${XDG_CONFIG_HOME}/opencode/opencode.json"
if [ -f "${OPENCODE_CONFIG_SRC}" ]; then
    cp -f "${OPENCODE_CONFIG_SRC}" "${OPENCODE_CONFIG_DST}"
else
    echo "[opencode-review] WARNING: opencode config not found at ${OPENCODE_CONFIG_SRC}" >&2
fi
export INFERENCE_HUB_API_KEY="${INFERENCE_HUB_API_KEY:-}"

# Resolve the review agent's configured model/provider for evidence.
OPENCODE_MODEL=""
if [ -f "${OPENCODE_CONFIG_DST}" ]; then
    OPENCODE_MODEL="$(python3 - "${OPENCODE_CONFIG_DST}" <<'PYEOF' 2>/dev/null || true
import json, sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as fh:
        cfg = json.load(fh)
except Exception:
    sys.exit(0)
agent = (cfg.get("agent") or {}).get("review") or {}
model = agent.get("model") or cfg.get("model") or ""
print(model)
PYEOF
)"
fi
if [ -z "${OPENCODE_MODEL}" ]; then
    OPENCODE_MODEL="${MAC_LLM_MODEL:-${MAC_AGENT_LLM_MODEL:-}}"
fi

started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

echo "===== mac-task-executor-opencode-review ====="
echo "started_at:       ${started_at}"
echo "MAC_TASK_ID:      ${MAC_TASK_ID:-<unset>}"
echo "MAC_LEASE_ID:     ${MAC_LEASE_ID:-<unset>}"
echo "MAC_AGENT_ID:     ${MAC_AGENT_ID:-<unset>}"
echo "MAC_AGENT_ROLE:   ${MAC_AGENT_ROLE:-<unset>}"
echo "MAC_URL:          ${MAC_URL:-<unset>}"
echo "REVIEW_TARGET:    ${REVIEW_TARGET}"
echo "XDG_CONFIG_HOME:  ${XDG_CONFIG_HOME}"
echo "opencode model:   ${OPENCODE_MODEL:-<unset>}"
echo "EVIDENCE_PATH:    ${EVIDENCE_PATH}"
if [ -n "${ATTESTATION_KEY}" ]; then
    echo "MAC_AGENT_ATTESTATION_KEY: <present>"
else
    echo "MAC_AGENT_ATTESTATION_KEY/MAC_ATTESTATION_KEY: <unset>"
fi
echo "opencode: $(opencode --version 2>/dev/null || echo '<unavailable>')"

PROMPT="Review task ${MAC_TASK_ID} (target evidence ${REVIEW_TARGET}). Perform a semantic code review independently. Read ${MAC_TASK_WORKSPACE:-/tmp}/executor-task.json and ${MAC_TASK_WORKSPACE:-/tmp}/executor-evidence.json. If a repository checkout is present at ${MAC_TASK_REPO_WORKTREE:-<none>}, inspect the exact checked-out commit. Return a fenced JSON object with verdict=approved, rejected, or infrastructure, summary, feedback, and findings. Passing tests never require you to approve a semantic defect. A broken clone, sandbox, bootstrap, CodeGraph service, or test-collection collapse is not a defect in the work — emit verdict=infrastructure rather than rejecting the change."
if [ -n "${MAC_URL}" ] && [ -n "${MAC_TASK_ID}" ] && [ -n "${MAC_WORKER_TOKEN}" ]; then
    task_json="$(curl -fsS --config - \
        "${MAC_URL}/tasks/${MAC_TASK_ID}" 2>/dev/null <<CURL || true
header = "Authorization: Bearer ${MAC_WORKER_TOKEN}"
CURL
)"
    if [ -n "${task_json}" ]; then
        task_context="$(printf '%s' "${task_json}" | python3 -c 'import json,sys
d=json.load(sys.stdin)
task=d.get("task") if isinstance(d.get("task"),dict) else d
print("Task title: %s\n\nTask description:\n%s" % (task.get("title","") or "", task.get("description","") or ""))' || true)"
        if [ -n "${task_context}" ]; then
            PROMPT="${PROMPT}

${task_context}"
        fi
    fi
fi

review_cwd="${MAC_TASK_REPO_WORKTREE:-${MAC_TASK_WORKSPACE:-$PWD}}"
review_assignment_json="{}"
if [ -n "${MAC_TASK_WORKSPACE:-}" ] && [ -f "${MAC_TASK_WORKSPACE}/task.json" ]; then
    review_assignment_json="$(python3 - "${MAC_TASK_WORKSPACE}/task.json" <<'PYEOF' 2>/dev/null || printf '{}'
import json
import sys

try:
    with open(sys.argv[1], "r", encoding="utf-8") as fh:
        payload = json.load(fh)
    task = payload.get("task") if isinstance(payload.get("task"), dict) else payload
    metadata = task.get("metadata") if isinstance(task.get("metadata"), dict) else {}
    assignment = metadata.get("review_experiment")
    if not isinstance(assignment, dict) or assignment.get("schema") != "mac.review_experiment.v1":
        assignment = {}
except Exception:
    assignment = {}
print(json.dumps(assignment, sort_keys=True))
PYEOF
)"
fi
review_experiment_id="$(printf '%s' "${review_assignment_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("experiment_id", ""))' 2>/dev/null || true)"
review_experiment_arm="$(printf '%s' "${review_assignment_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("arm", ""))' 2>/dev/null || true)"
review_experiment_blind="$(printf '%s' "${review_assignment_json}" | python3 -c 'import json,sys; print("1" if json.load(sys.stdin).get("blind") is True else "0")' 2>/dev/null || printf '0')"

if [ "${review_experiment_blind}" = "1" ]; then
    executor_evidence_path="${MAC_TASK_WORKSPACE}/executor-evidence.json"
    if [ ! -f "${executor_evidence_path}" ]; then
        echo "[opencode-review] FATAL: blind discovery requires executor evidence to withhold" >&2
        exit 4
    fi
    independent_findings_path="${MAC_TASK_WORKSPACE}/review-independent-findings.json"
    review_protocol_path="${MAC_TASK_WORKSPACE}/review-protocol.json"
    discovery_stdout="$(mktemp)"
    discovery_started_ns="$(python3 -c 'import time; print(time.time_ns())')"
    executor_evidence_payload="$(<"${executor_evidence_path}")"
    evidence_withheld=1
    restore_executor_evidence() {
        if [ "${evidence_withheld}" = "1" ]; then
            printf '%s\n' "${executor_evidence_payload}" > "${executor_evidence_path}"
            evidence_withheld=0
        fi
    }
    trap restore_executor_evidence EXIT HUP INT TERM
    rm -f "${executor_evidence_path}"
    DISCOVERY_PROMPT="Run the evidence-withheld discovery phase for review experiment ${review_experiment_id}, arm ${review_experiment_arm}. The host has physically removed executor-evidence.json. Read ${MAC_TASK_WORKSPACE}/executor-task.json, inspect the prepared checkout and diff at ${MAC_TASK_REPO_WORKTREE:-<none>}, and run focused checks. Do not decide approval yet. Return a fenced JSON object with findings as a list and no_findings_reason as a non-empty string when the list is empty. Each finding should include summary and, when applicable, severity, path, line, and supporting_check."
    set +e
    (cd "${review_cwd}" && opencode run --agent review --format json "${DISCOVERY_PROMPT}") > "${discovery_stdout}" 2>&1
    discovery_rc=$?
    set -e
    discovery_finished_ns="$(python3 -c 'import time; print(time.time_ns())')"
    restore_executor_evidence
    trap - EXIT HUP INT TERM

    export discovery_stdout discovery_rc discovery_started_ns discovery_finished_ns
    export review_experiment_id review_experiment_arm independent_findings_path review_protocol_path
    python3 <<'PYEOF'
import hashlib
import json
import os


def assistant_text(event):
    if not isinstance(event, dict):
        return ""
    role = str(event.get("role") or "")
    if role and role != "assistant":
        return ""
    content = event.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(
            str(item.get("text"))
            for item in content
            if isinstance(item, dict) and isinstance(item.get("text"), str)
        )
    part = event.get("part") if isinstance(event.get("part"), dict) else {}
    return str(part.get("text") or part.get("content") or "")


def fenced_blocks(text):
    marker = "```"
    start = 0
    while True:
        open_at = text.find(marker, start)
        if open_at < 0:
            return
        body_start = open_at + len(marker)
        if text[body_start : body_start + 4].lower() == "json":
            body_start += 4
        if body_start < len(text) and text[body_start] == "\n":
            body_start += 1
        close_at = text.find(marker, body_start)
        if close_at < 0:
            return
        yield text[body_start:close_at].strip()
        start = close_at + len(marker)


stdout_path = os.environ["discovery_stdout"]
try:
    with open(stdout_path, "rb") as fh:
        raw = fh.read()
except Exception:
    raw = b""
text = raw.decode("utf-8", "replace")
parsed = None
parse_error = ""
try:
    texts = []
    for line in text.splitlines():
        try:
            value = assistant_text(json.loads(line))
        except Exception:
            continue
        if value:
            texts.append(value)
    for value in reversed(texts):
        for block in reversed(list(fenced_blocks(value))):
            try:
                parsed = json.loads(block)
                break
            except Exception:
                continue
        if isinstance(parsed, dict):
            break
    if not isinstance(parsed, dict):
        raise ValueError("reviewer did not emit final fenced JSON")
except Exception as exc:
    parse_error = str(exc)
    parsed = {}

findings = parsed.get("findings") if isinstance(parsed.get("findings"), list) else []
no_findings_reason = str(parsed.get("no_findings_reason") or "").strip()
valid = bool(findings or no_findings_reason) and not parse_error
independent = {
    "schema": "mac.independent_review_findings.v1",
    "experiment_id": os.environ.get("review_experiment_id", ""),
    "arm": os.environ.get("review_experiment_arm", ""),
    "findings": findings,
    "no_findings_reason": no_findings_reason,
    "parse_error": parse_error,
}
with open(os.environ["independent_findings_path"], "w", encoding="utf-8") as fh:
    json.dump(independent, fh, indent=2, sort_keys=True)
    fh.write("\n")
with open(os.environ["independent_findings_path"], "rb") as fh:
    findings_raw = fh.read()

rc = int(os.environ.get("discovery_rc", "1"))
duration_ms = (
    int(os.environ.get("discovery_finished_ns", "0"))
    - int(os.environ.get("discovery_started_ns", "0"))
) / 1_000_000.0
protocol = {
    "schema": "mac.review_protocol.v1",
    "experiment_id": os.environ.get("review_experiment_id", ""),
    "arm": os.environ.get("review_experiment_arm", ""),
    "mode": "blind_discovery_then_adjudication",
    "executor_evidence_hidden": True,
    "discovery_returncode": rc,
    "discovery_duration_ms": round(duration_ms, 3),
    "discovery_stdout_sha256": "sha256:" + hashlib.sha256(raw).hexdigest(),
    "independent_findings_valid": valid,
    "independent_findings_count": len(findings),
    "independent_findings_sha256": "sha256:" + hashlib.sha256(findings_raw).hexdigest(),
    "protocol_compliant": bool(rc == 0 and valid),
}
with open(os.environ["review_protocol_path"], "w", encoding="utf-8") as fh:
    json.dump(protocol, fh, indent=2, sort_keys=True)
    fh.write("\n")
PYEOF
    rm -f "${discovery_stdout}"
    PROMPT="${PROMPT}

This is the adjudication phase of blind review experiment ${review_experiment_id}, arm ${review_experiment_arm}. Read ${independent_findings_path} before executor-evidence.json. Preserve, refine, or explicitly rebut every independent finding in the final findings or feedback; do not silently discard it."
fi

opencode_stdout="$(mktemp)"
set +e
(cd "${review_cwd}" && opencode run --agent review --format json "${PROMPT}") > "${opencode_stdout}" 2>&1
opencode_rc=$?
set -e
finished_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "[opencode-review] rc=${opencode_rc}"
sed -n '1,40p' "${opencode_stdout}" || true

tmp_path="${EVIDENCE_PATH}.tmp.$$"
export MAC_TASK_ID MAC_LEASE_ID MAC_AGENT_ID MAC_AGENT_ROLE REVIEW_TARGET
export started_at finished_at opencode_rc opencode_stdout OPENCODE_MODEL
python3 - "${tmp_path}" <<'PYEOF'
import hashlib
import json
import os
import re
import sys

out_path = sys.argv[1]
rc = int(os.environ.get("opencode_rc", "1"))
try:
    with open(os.environ["opencode_stdout"], "r", encoding="utf-8") as fh:
        stdout = fh.read()
except Exception:
    stdout = ""
task_id = os.environ.get("MAC_TASK_ID", "")
review_target = os.environ.get("REVIEW_TARGET", "")


# ---- JSONL event stream parser ----
def assistant_text_from_event(evt):
    if not isinstance(evt, dict):
        return ""
    role = str(evt.get("role") or "")
    if role and role != "assistant":
        return ""
    content = evt.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for item in content:
            if isinstance(item, dict) and isinstance(item.get("text"), str):
                parts.append(item["text"])
        return "\n".join(parts)
    part = evt.get("part") if isinstance(evt.get("part"), dict) else {}
    if isinstance(part.get("text"), str):
        return part["text"]
    if isinstance(part.get("content"), str):
        return part["content"]
    return ""


def extract_final_review_json(event_stream):
    texts = []
    for line in event_stream.splitlines():
        try:
            evt = json.loads(line)
        except Exception:
            continue
        text = assistant_text_from_event(evt)
        if text:
            texts.append(text)

    for text in reversed(texts):
        for block in reversed(list(fenced_json_blocks(text))):
            try:
                return json.loads(block)
            except Exception:
                continue
    raise ValueError("review agent did not emit final fenced JSON verdict")


def fenced_json_blocks(text):
    marker = "```"
    start = 0
    while True:
        open_at = text.find(marker, start)
        if open_at < 0:
            return
        body_start = open_at + len(marker)
        if text[body_start : body_start + 4].lower() == "json":
            body_start += 4
        if body_start < len(text) and text[body_start] == "\n":
            body_start += 1
        close_at = text.find(marker, body_start)
        if close_at < 0:
            return
        yield text[body_start:close_at].strip()
        start = close_at + len(marker)


# ---- Parse verdict from event stream ----
verdict = "rejected"
summary = "review parser failed"
feedback = ""
findings = []
try:
    review_json = extract_final_review_json(stdout)
    parsed_verdict = str(review_json.get("verdict") or "").strip().lower()
    if parsed_verdict not in {"approved", "rejected", "infrastructure"}:
        raise ValueError("unsupported verdict: %s" % parsed_verdict)
    verdict = parsed_verdict
    summary = str(review_json.get("summary") or "")
    feedback = str(review_json.get("feedback") or "")
    parsed_findings = review_json.get("findings")
    if isinstance(parsed_findings, list):
        findings = parsed_findings
except Exception as exc:
    verdict = "rejected"
    summary = "review parser failed"
    feedback = "Review output could not be parsed as final verdict JSON: %s" % exc
    findings = [{"severity": "blocking", "message": feedback}]

# ---- Deterministic worktree digest ----
# reviewed_evidence_id and executor_evidence_id are both REVIEW_TARGET today.
# Keep both positions in the digest schema so future divergence does not
# change the serialization format.
digest_input = json.dumps([task_id, review_target, review_target], separators=(",", ":"))
worktree_digest = "sha256:" + hashlib.sha256(digest_input.encode("utf-8")).hexdigest()

status = "complete"
result = "review_completed"
returncode = 0
checks = [{"name": "semantic_review", "status": "pass", "returncode": 0}]

# On infrastructure failure (manifest can't be written) we exit nonzero below.
manifest = {
    "schema": "mac.worker_evidence.v1",
    "status": status,
    "evidence_type": "review_verdict",
    "executor": "mac-task-executor-opencode-review",
    "verdict": verdict,
    "reviewed_evidence_id": review_target,
    "worktree_digest": worktree_digest,
    "summary": summary or "opencode review agent ran for task=%s verdict=%s" % (task_id, verdict),
    "feedback": feedback,
    "findings": findings,
    "result": result,
    "returncode": returncode,
    "opencode_model": os.environ.get("OPENCODE_MODEL", ""),
    "llm_model": os.environ.get("OPENCODE_MODEL", ""),
    "llm": {
        "tool": "opencode",
        "agent": "review",
        "model": os.environ.get("OPENCODE_MODEL", ""),
    },
    "started_at": os.environ.get("started_at", ""),
    "finished_at": os.environ.get("finished_at", ""),
    "executed_at": os.environ.get("finished_at", ""),
    "checks": checks,
    "notes": "opencode semantic review; canonical finalization and signing follow.",
}
try:
    with open(out_path, "w", encoding="utf-8") as fh:
        json.dump(manifest, fh, sort_keys=True)
except Exception as exc:
    print("[opencode-review] FATAL: cannot write manifest: %s" % exc, file=sys.stderr)
    sys.exit(5)
PYEOF

mv "${tmp_path}" "${EVIDENCE_PATH}"
if [ -z "${ATTESTATION_KEY}" ]; then
    echo "[opencode-review] FATAL: MAC_AGENT_ATTESTATION_KEY is required" >&2
    rm -f "${opencode_stdout}"
    exit 4
fi
if [ -z "${MAC_TASK_WORKSPACE:-}" ] || [ ! -f "${MAC_TASK_WORKSPACE}/task.json" ] || [ ! -f "${MAC_TASK_WORKSPACE}/executor-evidence.json" ]; then
    echo "[opencode-review] FATAL: canonical review workspace is missing" >&2
    rm -f "${opencode_stdout}"
    exit 4
fi
export MAC_ATTESTATION_KEY="${ATTESTATION_KEY}"
export MAC_WORKER_AGENT_ID="${MAC_AGENT_ID}"
export MAC_TASK_FILE="${MAC_TASK_FILE:-${MAC_TASK_WORKSPACE}/task.json}"
python3 -m mac.review_finalizer
if [ "${EVIDENCE_PATH}" != "${MAC_TASK_WORKSPACE}/mac-evidence.json" ]; then
    cp -f "${MAC_TASK_WORKSPACE}/mac-evidence.json" "${EVIDENCE_PATH}"
fi
echo "[opencode-review] canonical signed manifest -> ${EVIDENCE_PATH}"
rm -f "${opencode_stdout}"
exit 0
