ARG MAC_BASE_IMAGE=gitea.omv.a113.casa/vpogu/mac:bea1534a50d5
FROM ${MAC_BASE_IMAGE}

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates curl nodejs npm && \
    # git >= 2.38 is a hard prerequisite: the merge-gate suite and the
    # production merge queue call `git merge-tree --write-tree`, which older
    # distro git (e.g. Ubuntu 22.04 / 2.34.1) lacks, failing the authoritative
    # gate with an opaque rc=129. The floor is DECLARED in
    # .mac/project.yaml (toolchain.command_minimum_versions.git) and asserted
    # here at build time so the image cannot silently ship a too-old git.
    # Keep this floor in sync with that contract (tests/test_git_toolchain_floor.py).
    git_ver="$(git version | sed -E 's/^git version ([0-9]+\.[0-9]+).*/\1/')" && \
    git_major="${git_ver%%.*}" && git_minor="${git_ver#*.}" && \
    { [ "$git_major" -gt 2 ] || { [ "$git_major" -eq 2 ] && [ "$git_minor" -ge 38 ]; }; } || \
      { echo "FATAL: git $git_ver < required 2.38 (git merge-tree --write-tree)" >&2; exit 1; } && \
    npm install -g @openai/codex && \
    npm install -g opencode-ai && \
    npm cache clean --force && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/* /root/.npm /tmp/*

# The image is a BOOTSTRAP, not a per-project toolchain. It ships baseline
# Node + nvm (Node version switching), uv (Python interpreter + venv
# provisioning), and opencode (agent fallback). The pre-push gate
# (mac-task-executor-opencode-build) resolves and provisions each project's
# DECLARED toolchain at test time so the verdict reflects the code, not the
# image's defaults. Do not hardcode a project's Node/Python version here.

# Install nvm so the gate can switch to whatever Node version a project
# declares (.nvmrc, .node-version, engines.node, or CI workflow).
# nvm must be owned by the runtime user (mac) and sourced per-shell.
ENV NVM_DIR=/var/lib/mac/.nvm
RUN mkdir -p "${NVM_DIR}" && \
    curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | \
        NVM_DIR="${NVM_DIR}" PROFILE=/dev/null bash && \
    chown -R mac:mac "${NVM_DIR}"

# Install uv (Python package manager) using the Docker-recommended method
# See: https://docs.astral.sh/uv/guides/integration/docker/
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN uv --version

COPY deploy/codex-runner/mac-task-executor-codex /usr/local/bin/mac-task-executor-codex
COPY deploy/codex-runner/mac-task-executor-codex-review /usr/local/bin/mac-task-executor-codex-review
COPY deploy/codex-runner/mac-task-executor-opencode-build /usr/local/bin/mac-task-executor-opencode-build
COPY deploy/codex-runner/mac-task-executor-opencode-review /usr/local/bin/mac-task-executor-opencode-review
RUN chmod a+rx /usr/local/bin/mac-task-executor-codex \
               /usr/local/bin/mac-task-executor-codex-review \
               /usr/local/bin/mac-task-executor-opencode-build \
               /usr/local/bin/mac-task-executor-opencode-review

USER mac
WORKDIR /var/lib/mac

CMD ["sleep", "infinity"]
