__pycache__/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
coverage.json
coverage-*.json
htmlcov/
.test-portfolio/

# Test-gate checkpoint (src/mac/test_checkpoint.py). Per-workspace operational
# state that records which test files passed against which tree, so a failed
# gate run can resume instead of re-running 11,400 tests for a one-line fix.
# Never product content; CI restores it with actions/cache, not from git.
.mac-test-checkpoint/
.venv/
node_modules/
dist/
*.pyc
*.db
*.sqlite
*.db-shm
*.db-wal

# Legacy beads / Dolt files (removed; ignore so a stray bd init doesn't track them again)
.dolt/
.beads/
.beads-credential-key
.claude/worktrees/

# Operational task-ledger mirror (mac task is canonical; mirror is local-only).
.tickets/

# Per-task executor evidence manifest. Every task writes this into its own
# workspace and the hub ingests it from there (never from git), so it is
# per-run operational state, NOT product content. Committing it made every
# task branch modify the same repo-root file, so every publication merge
# conflicted on it and failed the merge gate. Keep it out of the tree.
mac-evidence.json

# Sibling per-run executor/worker/review artifacts (written into each task
# workspace by src/mac/worker.py, src/mac/executor_finalizer.py,
# src/mac/executor_prompt.py, and src/mac/executor_sandbox.py). Like
# mac-evidence.json above, these are per-run operational state, NOT product
# content: the hub ingests them from the task workspace, never from git.
# Committing them makes every task branch modify the same repo-root files, so
# every publication merge conflicts on them and fails the merge gate. Patterns
# are root-anchored (leading /) so legitimate product files elsewhere under
# src/ or tests/ are never masked.
/review-independent-findings.json
/review-independent-findings.previous.json
/review-independent-draft-evidence.json
/review-protocol.json
/review-result.json
/executor-evidence.json
/executor-evidence-preserved.json
/executor-task.json
/executor-policy.txt
/finalizer-progress.json
/harness-recovery-log.json
/mac-sandbox-verification.json
/openshell-salvage.json
/preserved-executor-worktree.json
/worker-result.json
/environment-contract.json
/environment-delta.json
/repository-worktree.json
/recovery-evidence.json
/recovery-test.stdout.txt
/recovery-test.stderr.txt
/stdout.txt
/stderr.txt
/.mac-agentbus-control-pending-repo-update.json
/.mac-executor-policy.txt
/.mac-agentbus-control.json
/.mac-withheld-executor-evidence.json

# Stray developer audit/scratch notes at the repo root are per-run artifacts,
# not product content, so keep them out of the tree.
/audit-findings.txt

# CodeGraph indexes are local generated state.
.codegraph/

# Ephemeral host-prefetched assets used by the OpenShell image build.
.mac-openshell-build-assets/
.vendor-check.sh
.vendor-check-work/
