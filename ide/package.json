{
  "name": "mac-ide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MAC Fleet Workbench — a cockpit-first, A2A-aware operator IDE for the multi-agent control plane.",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && mkdir -p ../dist && tar -czf ../dist/mac-ide-web.tar.gz -C dist .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "@xyflow/react": "^12.11.1",
    "allotment": "^1.20.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.5.4",
    "vite": "^8.1.2"
  }
}
